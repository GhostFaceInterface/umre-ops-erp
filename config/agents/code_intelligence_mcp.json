{
  "name": "umre_ops_code_intelligence",
  "transport": "stdio",
  "description": "Supabase pgvector-backed code intelligence tools for umre_ops.",
  "launcher": "scripts/run_mcp_server.sh",
  "tools": [
    "search_code",
    "get_file",
    "get_function",
    "code_index_status"
  ],
  "config_generators": {
    "cursor": "python scripts/agent_config.py --format cursor",
    "codex": "python scripts/agent_config.py --format codex",
    "generic": "python scripts/agent_config.py --format generic"
  }
}
